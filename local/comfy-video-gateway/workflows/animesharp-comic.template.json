{
 "_README": [
  "漫画线稿保持超分：2x-AnimeSharp RCAN 直接 2x 输出，不做缩回（区别于 animesharp-upscale 的视频 1280x704 收口）。",
  "模型 comic-hd：单图输入，输出 2x 分辨率（1152x1536 → 2304x3072）。",
  "占位符：{{IMAGE}}"
 ],
 "1": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "{{IMAGE}}",
   "upload": "image"
  }
 },
 "2": {
  "class_type": "UpscaleModelLoader",
  "inputs": {
   "model_name": "2x-AnimeSharpV4_Fast_RCAN_PU.safetensors"
  }
 },
 "3": {
  "class_type": "ImageUpscaleWithModel",
  "inputs": {
   "upscale_model": ["2", 0],
   "image": ["1", 0]
  }
 },
 "4": {
  "class_type": "SaveImage",
  "inputs": {
   "images": ["3", 0],
   "filename_prefix": "comic_hd/beeftv"
  }
 }
}
