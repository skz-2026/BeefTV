{
    "_README": [
        "FastH3 V2 图生视频（I2VA 首帧驱动）：首帧引用走官方已审路线。",
        "基于 fasth3-v2.template.json（DMD2 8 步完整学生模型 + learned VSA）加 first_frame 输入。",
        "依赖权重与 fasth3-v2 相同（fastvideo_fasth3_8step_v2_pruned_int8_convrot），不要叠加加速 LoRA。",
        "占位符：{{PROMPT}} {{WIDTH}} {{HEIGHT}} {{FRAMES}} {{SEED}} {{TEXT_ENCODER}} {{IMAGE}}"
    ],
    "1": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "fastvideo_fasth3_8step_v2_pruned_int8_convrot.safetensors",
            "weight_dtype": "default"
        }
    },
    "2": {
        "class_type": "CLIPLoader",
        "inputs": {
            "clip_name": "{{TEXT_ENCODER}}",
            "type": "minimax",
            "device": "default"
        }
    },
    "3": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "minimax_h3_video_vae_fp16.safetensors"
        }
    },
    "4": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
        }
    },
    "13": {
        "class_type": "LoadImage",
        "inputs": {
            "image": "{{IMAGE}}",
            "upload": "image"
        }
    },
    "5": {
        "class_type": "MiniMaxH3AudioConditioningT8",
        "inputs": {
            "clip": ["2", 0],
            "video_vae": ["3", 0],
            "audio_vae": ["4", 0],
            "first_frame": ["13", 0],
            "prompt": "{{PROMPT}}",
            "width": "{{WIDTH}}",
            "height": "{{HEIGHT}}",
            "length": "{{FRAMES}}",
            "task_type": "I2VA",
            "audio_mode": "native",
            "audio_denoise_strength": 1,
            "add_source_as_reference": false,
            "prompt_primary_audio_ordinal": 0,
            "strict_prompt_tags": true,
            "ref_image_size": "match",
            "reference_video_policy": "official_2_to_15s"
        }
    },
    "6": {
        "class_type": "MiniMaxH3FastH3V2SetupEXPT8",
        "inputs": {
            "model": ["1", 0],
            "av_latent": ["5", 1],
            "profile": "trained_vsa_exp",
            "min_tokens": 0
        }
    },
    "7": {
        "class_type": "BasicGuider",
        "inputs": {
            "model": ["6", 0],
            "conditioning": ["5", 0]
        }
    },
    "8": {
        "class_type": "RandomNoise",
        "inputs": {
            "noise_seed": "{{SEED}}",
            "control": "fixed"
        }
    },
    "9": {
        "class_type": "SamplerCustomAdvanced",
        "inputs": {
            "noise": ["8", 0],
            "guider": ["7", 0],
            "sampler": ["6", 1],
            "sigmas": ["6", 2],
            "latent_image": ["5", 1]
        }
    },
    "10": {
        "class_type": "MiniMaxH3FastH3V2RuntimeAuditEXPT8",
        "inputs": {
            "model": ["6", 0],
            "sampled_av_latent": ["9", 0]
        }
    },
    "11": {
        "class_type": "MiniMaxH3AVDecodeT8",
        "inputs": {
            "av_latent": ["10", 0],
            "video_vae": ["3", 0],
            "audio_vae": ["4", 0]
        }
    },
    "12": {
        "class_type": "VHS_VideoCombine",
        "inputs": {
            "images": ["11", 0],
            "audio": ["11", 1],
            "frame_rate": 24,
            "loop_count": 0,
            "filename_prefix": "MiniMaxH3/beeftv_fasth3_i2v",
            "format": "video/h264-mp4",
            "pix_fmt": "yuv420p",
            "crf": 19,
            "save_metadata": true,
            "trim_to_audio": false,
            "pingpong": false,
            "save_output": true
        }
    }
}
