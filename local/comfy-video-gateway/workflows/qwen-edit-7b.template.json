{
    "_README": [
        "Qwen-Image-2.1 7B 编辑版：用已有的 7B 底模（6.9GB）+ PE-I2I 编辑编码器（9GB）。",
        "16GB 显存可完整加载，速度秒级。多参考图走 TextEncodeQwenImageEditPlus（3 张独立输入）。",
        "占位符：{{PROMPT}} {{WIDTH}} {{HEIGHT}} {{SEED}} {{IMAGE}} {{IMAGE_2}} {{IMAGE_3}}"
    ],
    "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "qwen_image_2.1_int8_convrot.safetensors", "weight_dtype": "default" } },
    "3": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3.5_9b_qwen_image_2.1_pe_i2i.int8_convrot.safetensors", "type": "qwen_image", "device": "default" } },
    "5": { "class_type": "VAELoader", "inputs": { "vae_name": "qwen_image_2.1_vae_bf16.safetensors" } },
    "13": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE}}", "upload": "image" } },
    "22": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_2}}", "upload": "image" } },
    "23": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE_3}}", "upload": "image" } },
    "4": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["1", 0], "lora_name": "qwen_image_2.1_viggle_turbo_r64.safetensors", "strength_model": 1.0 } },
    "6": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["4", 0], "shift": 3.0 } },
    "7": { "class_type": "TextEncodeQwenImageEditPlus", "inputs": { "clip": ["3", 0], "prompt": "{{PROMPT}}", "vae": ["5", 0], "image1": ["13", 0], "image2": ["22", 0], "image3": ["23", 0] } },
    "8": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 0], "text": "" } },
    "9": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "batch_size": 1 } },
    "10": { "class_type": "KSampler", "inputs": { "model": ["6", 0], "positive": ["7", 0], "negative": ["8", 0], "latent_image": ["9", 0], "seed": "{{SEED}}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0 } },
    "11": { "class_type": "VAEDecode", "inputs": { "samples": ["10", 0], "vae": ["5", 0] } },
    "12": { "class_type": "SaveImage", "inputs": { "images": ["11", 0], "filename_prefix": "QwenImage21Edit/beeftv" } }
}
