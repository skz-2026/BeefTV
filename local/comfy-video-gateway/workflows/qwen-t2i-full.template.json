{
    "_README": [
        "Qwen-Image-2.1 Base 满血文生图（官方 40 步、cfg=2.5，无任何加速/LoRA），OpenAI Images 协议用。",
        "权重：diffusion_models/qwen_image_2.1_int8_convrot.safetensors（与 4 步 LoRA 线、Turbo 共用同一底模），",
        "text_encoders/qwen3vl_8b_int8_convrot.safetensors（CLIPLoader type=qwen_image）+",
        "vae/qwen_image_2.1_vae_bf16.safetensors。步数 40 与 cfg 2.5：40 为官方模型卡默认，",
        "cfg 2.5 沿用本机 UC GGUF（Base 衍生非蒸馏）实测线；euler/simple、shift 3.0 与其他 Qwen 模板一致。",
        "用途：定稿级精修。16GB 卡 1024×1024 约 3 分钟/张（80 次前向），不要用于批量草稿。",
        "占位符：{{PROMPT}} {{NEGATIVE_PROMPT}} {{WIDTH}} {{HEIGHT}} {{SEED}} {{TEXT_ENCODER}}"
    ],
    "1": {
        "class_type": "UNETLoader",
        "inputs": {
            "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
            "weight_dtype": "default"
        }
    },
    "3": {
        "class_type": "ModelSamplingAuraFlow",
        "inputs": {
            "model": ["1", 0],
            "shift": 3.0
        }
    },
    "4": {
        "class_type": "CLIPLoader",
        "inputs": {
            "clip_name": "{{TEXT_ENCODER}}",
            "type": "qwen_image",
            "device": "default"
        }
    },
    "5": {
        "class_type": "VAELoader",
        "inputs": {
            "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
        }
    },
    "6": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "clip": ["4", 0],
            "text": "{{PROMPT}}"
        }
    },
    "7": {
        "class_type": "CLIPTextEncode",
        "inputs": {
            "clip": ["4", 0],
            "text": "{{NEGATIVE_PROMPT}}"
        }
    },
    "8": {
        "class_type": "EmptyLatentImage",
        "inputs": {
            "width": "{{WIDTH}}",
            "height": "{{HEIGHT}}",
            "batch_size": 1
        }
    },
    "9": {
        "class_type": "KSampler",
        "inputs": {
            "model": ["3", 0],
            "positive": ["6", 0],
            "negative": ["7", 0],
            "latent_image": ["8", 0],
            "seed": "{{SEED}}",
            "steps": 40,
            "cfg": 2.5,
            "sampler_name": "euler",
            "scheduler": "simple",
            "denoise": 1.0
        }
    },
    "10": {
        "class_type": "VAEDecode",
        "inputs": {
            "samples": ["9", 0],
            "vae": ["5", 0]
        }
    },
    "11": {
        "class_type": "SaveImage",
        "inputs": {
            "images": ["10", 0],
            "filename_prefix": "QwenImage21/beeftv_t2i_full"
        }
    }
}
